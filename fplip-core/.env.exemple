# FPLIP API Environment Variables
# Copy this to .env and fill in real values

# GCP Configuration
GCP_PROJECT=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id
GOLD_DATASET=fplip_gold

# Path to the api_sa service account key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/secrets/api-sa-key.json

# API Key for app-level authentication (generate a random value)
API_KEY=your-secure-api-key-here

# Cache TTL in seconds (default: 4 hours)
CACHE_TTL_SECONDS=14400