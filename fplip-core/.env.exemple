# FPLIP API Environment Variables
# Copy this to .env and fill in real values

# GCP Configuration
GCP_PROJECT=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id
GOLD_DATASET=fplip_gold

# Path to Service Account Key files
# API Service Account (Read-Only: BigQuery Data Viewer on fplip_gold + Job User)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/api-sa-key.json
API_SA_KEY_PATH=./secrets/api-sa-key.json

# Ingestion Service Account (Read-Write: BigQuery Data Editor on Bronze/Silver/Gold)
INGESTION_SA_KEY_PATH=./secrets/ingestion-sa-key.json

# API Key for app-level authentication (generate a random value)
API_KEY=your-secure-api-key-here
INTERNAL_API_KEY=your-secure-internal-api-key-here
ENFORCE_INTERNAL_KEY=true

# Cache TTL in seconds (default: 4 hours)
CACHE_TTL_SECONDS=14400